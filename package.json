  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "build:app": "node scripts/build-app.mjs",
    "app:sync": "node scripts/build-app.mjs && cap sync",
