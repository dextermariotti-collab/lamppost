# Copy to .env for local development (`npm run dev` loads it). Never commit .env.
# In production the same names are Cloudflare Worker secrets (docs/deploy.md), except the two
# VITE_ values, which are built into the browser bundle and so must be set when you run the build.

# --- Supabase (Project Settings → API) ---
# Public by design: the browser uses these, and RLS decides what they can do.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# The same two values, for server-side rendering and server functions.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET: bypasses RLS. Server only; never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- AI (Google AI Studio → API keys; use a project with billing enabled) ---
# SECRET. Without it every AI feature says it's unavailable and the rest of the app works.
AI_API_KEY=""
# Optional: any OpenAI-compatible service instead of Google's Gemini endpoint. If you set it,
# name that service's models in src/lib/ai-models.ts.
# AI_BASE_URL="https://openrouter.ai/api/v1"

# --- Lesson cache warm-up (routes/api/public/warm-curriculum.ts) ---
# SECRET. Any long random string; the warm-up endpoint refuses requests without it.
WARM_TOKEN=""
