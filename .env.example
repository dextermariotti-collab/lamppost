# Copy to .env for local development (`npm run dev` loads it). Never commit .env.
# In production the same names are Cloudflare Worker secrets (docs/deploy.md), except the VITE_
# values and NITRO_PRESET, which are read when you run the build (the VITE_ ones are built into
# the browser bundle).

# --- Supabase (Project Settings → API) ---
# Public by design: the browser uses these, and RLS decides what they can do.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# The same two values, for server-side rendering and server functions.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET: bypasses RLS. Server only; never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- AI (Google AI Studio → API keys; use a project with billing enabled) ---
# SECRET. Without it every AI feature says it's unavailable and the rest of the app works.
AI_API_KEY=""
# Optional: any OpenAI-compatible service instead of Google's Gemini endpoint. If you set it,
# name that service's models in src/lib/ai-models.ts.
# AI_BASE_URL="https://openrouter.ai/api/v1"

# --- Rate limits (src/lib/rate-limit.server.ts) ---
# SECRET, optional: the key network addresses are hashed with before a rate limit stores them.
# Without it, one is derived from SUPABASE_SERVICE_ROLE_KEY.
RATE_LIMIT_SECRET=""

# --- Phone apps (npm run build:app; docs/mobile.md) ---
# Built into the app: the deployed backend its server calls go to, and the web address used in
# links people share and in sign-up emails.
VITE_API_URL="https://YOUR-DOMAIN"
VITE_PUBLIC_URL="https://YOUR-DOMAIN"
# Server only, optional: extra origins allowed to call the backend besides the apps'
# (capacitor://localhost, https://localhost). Comma-separated; for local testing.
APP_ORIGINS=""

# --- Lesson cache warm-up (routes/api/public/warm-curriculum.ts) ---
# SECRET. Any long random string; the warm-up endpoint refuses requests without it.
WARM_TOKEN=""

# --- Build (vite.config.ts) ---
# Optional: the host `npm run build` targets. Empty means Cloudflare Workers (cloudflare-module);
# for example node-server or vercel.
NITRO_PRESET=""
